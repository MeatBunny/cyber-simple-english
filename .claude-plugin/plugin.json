{
  "name": "cyber-simple-english",
  "displayName": "Cyber Simple English",
  "description": "Write clear, unambiguous cybersecurity documentation and training content, based on the rules of ASD-STE100 Simplified Technical English: short sentences, one word one meaning, active voice, condition before command, no definitions that a security reader does not need.",
  "version": "1.0.0",
  "author": {
    "name": "meatbunny"
  },
  "homepage": "https://github.com/MeatBunny/cyber-simple-english",
  "repository": "https://github.com/MeatBunny/cyber-simple-english",
  "license": "MIT",
  "keywords": [
    "technical-writing",
    "documentation",
    "ste",
    "asd-ste100",
    "cybersecurity",
    "incident-response",
    "runbooks",
    "training"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/hooks/cyber-simple-english-activate.js\" --no-pointer",
            "timeout": 5,
            "statusMessage": "Loading Cyber Simple English..."
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/hooks/cyber-simple-english-activate.js\" --cyber 1",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/hooks/cyber-simple-english-activate.js\" --cyber 2",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/hooks/cyber-simple-english-activate.js\" --cyber 3",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/hooks/cyber-simple-english-activate.js\" --cyber 4",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/src/hooks/lint_hook.py\"",
            "timeout": 10,
            "statusMessage": "Cyber Simple English: checking the file..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/src/hooks/lint_hook.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
